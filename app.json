{
  "expo": {
    "name": "CricCorner",
    "slug": "criccorner",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "criccorner",
    "newArchEnabled": false,
    "splash": {
      "backgroundColor": "#01365C",
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourcompany.criccorner"
    },
    "android": {
      "package": "com.criccorner",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "backgroundColor": "#01365C"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "CricCorner needs access to your photos so you can set a profile picture.",
          "cameraPermission": "CricCorner needs camera access so you can take a profile picture."
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "dcb8cc9e-23c2-4c09-85fe-cf70eadb448c"
      }
    },
    "owner": "cric-corner",
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
